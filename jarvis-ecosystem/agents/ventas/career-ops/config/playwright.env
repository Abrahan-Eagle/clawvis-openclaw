# Canal de Playwright por defecto en este workspace (Ventas / Jarvis).
# Usa Google Chrome instalado en el sistema cuando el Chromium empaquetado
# no se puede instalar (p. ej. mensaje "does not support chromium on ...").
# Comenta la linea o borra el archivo si prefieres solo: npx playwright install chromium
CAREER_OPS_PLAYWRIGHT_CHANNEL=chrome
