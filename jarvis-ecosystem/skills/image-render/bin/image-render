#!/usr/bin/env bash
# image-render — wrapper que invoca lib/render.py dentro del venv local
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SKILL_DIR=$(dirname "$(dirname "$SELF")")
VENV="${IMAGE_RENDER_VENV:-$SKILL_DIR/.venv}"
PY="$VENV/bin/python3"

if [ ! -x "$PY" ]; then
  echo "ERROR: venv no inicializado. Ejecuta:" >&2
  echo "  cd $SKILL_DIR && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt" >&2
  exit 1
fi

exec "$PY" "$SKILL_DIR/lib/render.py" "$@"
