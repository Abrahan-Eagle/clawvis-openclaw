# Copiar a /etc/jmc/jmc-adapter.env (systemd system) o ~/.config/jmc/jmc-adapter.env (systemd --user)
# chmod 600 y no commitear.

JMC_BEARER_TOKEN=cambiar_por_hex_de_al_menos_32_caracteres_usar_openssl_rand_hex_32
JMC_REPO_ROOT=/ruta/absoluta/a/jarvis-ecosystem
# Forzar openclaw.json concreto (prioridad sobre ~/.openclaw/); útil en CI/tests.
# JMC_OPENCLAW_JSON_PATH=/ruta/absoluta/a/jarvis-ecosystem/openclaw.json
JMC_BIND=127.0.0.1
JMC_PORT=8765

# Opcional: ruta absoluta al binario uvicorn del venv (si no usas jarvis-ecosystem/.venv-jmc).
# Tras definirlo, ejecuta de nuevo scripts/jmc-systemd-install.sh para regenerar la unidad con esa ruta.
# JMC_UVICORN_BIN=/home/usuario/jarvis-ecosystem/.venv-jmc/bin/uvicorn

# Opcional v1.8 — permitir POST /v1/modes/current (escribe JARVIS_AUTONOMY_MODE en ~/.openclaw/.env)
# JMC_ALLOW_MODE_WRITE=1  # obsoleto: POST /v1/modes/current ya no lo exige
# Ruta alternativa del .env (default: ~/.openclaw/.env)
# JMC_OPENCLAW_ENV_PATH=/home/usuario/.openclaw/.env

# --- v1.9 (opcional) — branding en /v1/health y cabecera UI ---
# JMC_BRAND_NAME=Mi Mission Control
# JMC_BRAND_EMOJI=🛰
# JMC_BRAND_COMPANY=Mi empresa
# JMC_BRAND_OWNER=Equipo Jarvis
# JMC_BRAND_AVATAR=

# Lockout tras intentos fallidos de Bearer (por IP del cliente)
# JMC_AUTH_FAIL_MAX=10
# JMC_AUTH_FAIL_WINDOW=900

# Lista cerrada de servicios para GET /v1/runtime/services (CSV). Ejemplo razonable:
# JMC_RUNTIME_SERVICES=jmc-adapter
# Nunca incluir servicios sensibles ni exponer más de lo necesario.
# JMC_RUNTIME_LOGS=1   # v1.10: permite ?journal_lines<=20 en runtime/services

# --- v1.10 (opcional) ---
# JMC_TASK_ZOMBIE_HOURS=72
# JMC_MEMORY_STALE_DAYS=14
# JMC_EXT_HEALTHCHECKS=status|https://example.com/health,api|https://api.example.com/ping
# JMC_EXT_ALLOW_LOCAL=0
# JMC_WEBHOOK_URL=https://hooks.example.com/jmc
# JMC_WEBHOOK_SECRET=hex_o_secreto_compartido

# --- Webhook entrante Telegram → activity-log (sin Bearer; cabecera dedicada) ---
# POST http://127.0.0.1:8765/v1/webhooks/inbound/telegram
# Cabecera: X-JMC-Inbound-Secret: <este valor>
# Body JSON: {"direction":"in"|"out","agent":"jarvis","text":"resumen","payload":{...opcional}}
# JMC_INBOUND_TELEGRAM_SECRET=openssl_rand_hex_24_o_mas
# JMC_BRAND_DESCRIPTION=...
# JMC_BRAND_LOCATION=...
# JMC_BRAND_BIRTH_DATE=...
# JMC_BRAND_TWITTER=@handle
