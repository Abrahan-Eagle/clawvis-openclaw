OLLAMA_API_KEY="ollama-local"
OLLAMA_API_BASE="http://127.0.0.1:11434"

# ClawFlows: automatizaciones locales del ecosistema Jarvis
# CLAWFLOWS_DIR: lo define scripts/clawflows-env.sh (recomendado). Si cargas solo .env sin ese script, pon aquí la ruta absoluta a .../jarvis-ecosystem/automations en tu máquina.
CLAWFLOWS_DIR="${CLAWFLOWS_DIR:-}"
CLAWFLOWS_REGISTRY="https://clawflows.com"
# CLAWFLOWS_SKILLS: usar scripts/clawflows-env.sh (incluye skills empaquetados de openclaw + jarvis)
