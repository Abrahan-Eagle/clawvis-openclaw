{
  "agent": {
    "model": "google/gemini-2.5-flash"
  },
  "agents": {
    "defaults": {
      "model": "google/gemini-1.5-flash",
      "fallbacks": [
        "google/gemini-2.0-flash",
        "google/gemini-2.0-flash-lite-preview-02-05",
        "ollama/qwen2.5-coder:0.5b",
        "ollama/phi"
      ],
      "subagents": {
        "maxConcurrent": 4
      }
    },
    "list": [
      {
        "id": "jarvis",
        "workspace": "./agents/jarvis",
        "default": true,
        "heartbeat": {
          "every": "30m",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "08:00",
            "end": "24:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-content",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-social",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-analytics",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-ads",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-email",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      {
        "id": "mkt-research",
        "workspace": "./agents/marketing",
        "heartbeat": {
          "every": "2h",
          "target": "none",
          "lightContext": true,
          "activeHours": {
            "start": "09:00",
            "end": "22:00",
            "timezone": "America/Caracas"
          }
        }
      },
      { "id": "sales-hunter", "workspace": "./agents/ventas" },
      { "id": "sales-closer", "workspace": "./agents/ventas" },
      { "id": "sales-account", "workspace": "./agents/ventas" }
    ]
  },
  "bindings": [
    { "agentId": "jarvis", "match": { "channel": "whatsapp", "accountId": "*" } }
  ],
  "channels": {
    "whatsapp": {
      "dmPolicy": "pairing"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": ["lobster"]
  }
}
