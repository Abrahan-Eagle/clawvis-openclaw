# Copiar a ~/.config/mempalace/restore.env y ajustar rutas.
# El script mempalace-auto-mine.sh lo carga si existe.

# Raíz del clon del repo donde vive jarvis-ecosystem/ (obligatorio para mine del ecosistema)
JARVIS_ECOSYSTEM=/ruta/al/clon/jarvis-ecosystem

# Opcional: sesiones OpenClaw del agente jarvis
# OPENCLAW_SESSIONS=${HOME}/.openclaw/agents/jarvis/sessions

# Opcional: palace ChromaDB
# MEMPALACE_PALACE=${HOME}/.mempalace/palace
