[Unit]
Description=OpenClaw Gateway (user session)
After=network-online.target
Wants=network-online.target

# Copiar a: ~/.config/systemd/user/openclaw-gateway.service
# Ajustar ExecStart si tu Node/nvm está en otra ruta (nvm: ~/.nvm/versions/node/v22.x.x/bin/node)

[Service]
EnvironmentFile=-%h/.openclaw/.env
ExecStart=/home/aipp/.nvm/versions/node/v22.22.2/bin/node /home/aipp/.nvm/versions/node/v22.22.2/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=60
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=/home/aipp
Environment=TMPDIR=/tmp
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
# Incluir ~/.local/bin para el CLI `agent` de Cursor si el gateway o plugins lo invocan.
Environment=PATH=/home/aipp/.local/bin:/home/aipp/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway

[Install]
WantedBy=default.target
