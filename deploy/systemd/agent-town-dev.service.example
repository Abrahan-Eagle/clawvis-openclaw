# Opcional: Agent Town al iniciar sesión (usuario systemd).
# Copiar a ~/.config/systemd/user/agent-town-dev.service
# Ajustar rutas de usuario, nvm y del repo.
#
# Requiere: pnpm install en agent-town (una vez).
#
# systemctl --user daemon-reload
# systemctl --user enable --now agent-town-dev.service
#
# UI: http://localhost:3000  —  proxy WS: /api/gateway → GATEWAY_URL (OpenClaw 18789)
# "pnpm dev" ejecuta tsx server.ts (ver package.json del proyecto).

[Unit]
Description=Agent Town (dev server, Next + WS proxy al gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/aipp
Environment=PATH=/home/aipp/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=GATEWAY_URL=ws://127.0.0.1:18789/
WorkingDirectory=/var/www/clawvis-openclaw/agent-town
ExecStart=/home/aipp/.nvm/versions/node/v22.22.2/bin/pnpm dev
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
