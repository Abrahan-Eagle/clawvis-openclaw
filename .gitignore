# Dependencias (cualquier subproyecto)
node_modules/

# Variables de entorno en la raíz del monorepo (no secretos en git)
.env
.env.*
!.env.example

# Agent Town — no versionar artefactos de build ni dependencias
agent-town/node_modules/
jarvis-ecosystem/agents/jarvis/scripts/node_modules/
agent-town/.next/
agent-town/out/
agent-town/.turbo/
agent-town/.env.local
agent-town/.env*.local

# Jarvis — skills con venv local (youtube-transcript, etc.)
jarvis-ecosystem/skills/**/.venv/
jarvis-ecosystem/skills/browser-playwright/node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
**/.venv/
**/.venv-*/

# Venvs locales del ecosistema (no versionar)
jarvis-ecosystem/.venv-jmc/
jarvis-ecosystem/agents/jarvis/.venv-docconv/
jarvis-ecosystem/desktop/**/.venv/
tools/**/.venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/

# Logs sueltos (opcional)
*.log

# OpenClaw — estado en runtime (no versionar: privacidad, tamaño, drift)
# Política: `docs/OPENCLAW_STATE_GIT_POLICY.md`
openclaw-state/.env
openclaw-state/agents/**/sessions/
openclaw-state/agents/**/auth-profiles.json
openclaw-state/memory/
openclaw-state/openclaw.json.bak*

# Identidad del dispositivo (claves PEM) — nunca en git
openclaw-state/identity/

# Perfil Chromium embebido (pesado) — dir o symlink
openclaw-state/browser/openclaw/user-data
openclaw-state/browser/openclaw/user-data/
openclaw-state/browser/openclaw/user-data.bak
openclaw-state/browser/openclaw/user-data.bak/
openclaw-state/browser/**/user-data
openclaw-state/browser/**/user-data/
openclaw-state/browser/**/user-data.bak
openclaw-state/browser/**/user-data.bak/

# Credenciales de canales (WhatsApp, etc.) — no subir
openclaw-state/credentials/

# Dispositivos emparejados (tokens operator del gateway)
openclaw-state/devices/

# Cola de entrega / logs / corridas cron (runtime, PII, sessionIds)
openclaw-state/delivery-queue/
openclaw-state/logs/
openclaw-state/cron/runs/
openclaw-state/cron/*.bak
openclaw-state/cron/jobs.json.bak

# Plantilla config: no versionar corridas ni backups de cron
config/openclaw-home/cron/runs/
config/openclaw-home/cron/*.bak
config/openclaw-home/cron/jobs.json.bak
config/openclaw-home/logs/
config/openclaw-home/delivery-queue/
config/openclaw-home/devices/

# Variables de entorno del ecosistema Jarvis (ClawFlows, scripts) — no subir
jarvis-ecosystem/.env
jarvis-ecosystem/.env.*
jarvis-ecosystem/agents/ventas/career-ops/node_modules/

# Graphify (output local, regenerable con graphify)
graphify-out/
.graphify_python

# Jarvis ecosystem — capa de coordinacion (Fase 1+ v2)
# state/ es runtime local: log de actividad, tareas vivas, handoffs, cache de imagenes IA
jarvis-ecosystem/state/activity-log.jsonl
jarvis-ecosystem/state/tasks/
jarvis-ecosystem/state/handoffs/
jarvis-ecosystem/state/cache/
jarvis-ecosystem/state/approvals/
jarvis-ecosystem/state/judge/
jarvis-ecosystem/state/editorial-calendar/
jarvis-ecosystem/state/metrics/
jarvis-ecosystem/state/publish-log/
jarvis-ecosystem/state/publish-safety/
jarvis-ecosystem/state/reports/
jarvis-ecosystem/state/competitor-intel/
jarvis-ecosystem/state/escalations/
# Salidas generadas por el pipeline RRSS (carruseles, reels)
jarvis-ecosystem/out/
# Plantillas de musica libre con licencia (las descarga el usuario, no se versionan)
jarvis-ecosystem/assets/music/*.mp3
jarvis-ecosystem/assets/music/*.wav
jarvis-ecosystem/assets/music/*.m4a
# Fuentes locales (pueden ser pesadas; el repo apunta a fallback DejaVu del sistema)
jarvis-ecosystem/assets/fonts/*.ttf
jarvis-ecosystem/assets/fonts/*.otf
# Skills nuevos con venv / node_modules
jarvis-ecosystem/skills/video-short/remotion/node_modules/
jarvis-ecosystem/skills/video-short/remotion/out/
