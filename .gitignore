# Dependencias (cualquier subproyecto)
node_modules/

# Variables de entorno en la raíz del monorepo (no secretos en git)
.env
.env.*
!.env.example

# Agent Town — no versionar artefactos de build ni dependencias
agent-town/node_modules/
jarvis-ecosystem/agents/jarvis/scripts/node_modules/
agent-town/.next/
agent-town/out/
agent-town/.turbo/
agent-town/.env.local
agent-town/.env*.local

# Python
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/

# Logs sueltos (opcional)
*.log

# OpenClaw — estado en runtime (no versionar: privacidad, tamaño, drift)
# Política: `docs/OPENCLAW_STATE_GIT_POLICY.md`
openclaw-state/.env
openclaw-state/agents/**/sessions/
openclaw-state/memory/
openclaw-state/openclaw.json.bak*

# Perfil Chromium embebido (pesado)
openclaw-state/browser/openclaw/user-data/

# Credenciales de canales (WhatsApp, etc.) — no subir
openclaw-state/credentials/

# Variables de entorno del ecosistema Jarvis (ClawFlows, scripts) — no subir
jarvis-ecosystem/.env
jarvis-ecosystem/.env.*
jarvis-ecosystem/agents/ventas/career-ops/node_modules/

# Graphify (output local, regenerable con graphify)
graphify-out/
.graphify_python
